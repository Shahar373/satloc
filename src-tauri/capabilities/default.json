{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Desktop capability for the main SatLoc window (updater, process and window-state exist on desktop only).",
  "platforms": [
    "windows",
    "macOS",
    "linux"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://celestrak.org/*"
        },
        {
          "url": "https://tle.ivanstanojevic.me/*"
        }
      ]
    },
    "updater:default",
    "process:default",
    "window-state:default"
  ]
}
