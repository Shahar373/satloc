{
  "name": "satloc",
  "private": true,
  "version": "0.1.1",
  "description": "Google Earth-style globe with satellites in real time, focused on ImageSat International (ISI).",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-cesium.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "tauri": "tauri",
    "icons": "node scripts/make-icon.mjs && tauri icon src-tauri/icon-source.png -o src-tauri/icons"
  },
  "dependencies": {
    "@tauri-apps/plugin-http": "^2.6.0",
    "cesium": "^1.145.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "satellite.js": "^7.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
